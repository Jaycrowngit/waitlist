---
import Choice from './Choice.astro';

const WHATSAPP_COMMUNITY = 'https://chat.whatsapp.com/Dy40STADiw62Pvg5jPJ1qs';
---

<div class="card" id="formCard" hidden>
  <form id="waitlistForm" novalidate>
    <div class="progress" aria-hidden="true"><span id="progressBar"></span></div>
    <p class="step-count" id="stepCount">Step 1 of 3</p>

    <!-- Step 1 -->
    <fieldset class="step is-active" data-step="1">
      <legend>Tell us about you</legend>

      <label for="full_name">Full name</label>
      <input id="full_name" name="full_name" type="text" autocomplete="name" maxlength="120" />
      <small class="error" data-for="full_name"></small>

      <label for="whatsapp_number">WhatsApp number</label>
      <input id="whatsapp_number" name="whatsapp_number" type="tel" autocomplete="tel" placeholder="0803 000 0000" maxlength="20" />
      <small class="error" data-for="whatsapp_number"></small>

      <label for="email">Email address</label>
      <input id="email" name="email" type="email" autocomplete="email" placeholder="you@example.com" />
      <small class="error" data-for="email"></small>
    </fieldset>

    <!-- Step 2 -->
    <fieldset class="step" data-step="2">
      <legend>Your phone usage</legend>

      <Choice
        name="network"
        question="Which network do you use most?"
        options={[{ value: 'MTN' }, { value: 'Airtel' }, { value: 'Glo' }, { value: '9mobile' }]}
        otherPlaceholder="Which network?"
      />

      <Choice
        name="monthly_data"
        question="How much data do you buy monthly?"
        options={[
          { value: 'Less than 5GB' },
          { value: '5GB – 10GB', label: '5 – 10GB' },
          { value: '10GB – 20GB', label: '10 – 20GB' },
          { value: '20GB – 50GB', label: '20 – 50GB' },
          { value: 'More than 50GB', label: '50GB+' },
        ]}
        otherPlaceholder="Tell us how much"
      />
    </fieldset>

    <!-- Step 3 -->
    <fieldset class="step" data-step="3">
      <legend>Bills &amp; extras</legend>

      <Choice
        name="electricity_provider"
        question="Who is your electricity provider?"
        options={[{ value: 'IBEDC' }, { value: 'IKEDC' }, { value: 'EKEDC' }, { value: 'AEDC' }]}
        otherPlaceholder="Which provider?"
      />

      <Choice
        name="betting_interest"
        question="Are you interested in betting top-ups?"
        options={[{ value: '1', label: 'Yes' }, { value: '0', label: 'No' }]}
        twoColumns
      />
    </fieldset>

    <!-- Honeypot: hidden from people, filled by bots -->
    <input class="hp" name="website" type="text" tabindex="-1" autocomplete="off" aria-hidden="true" />

    <p class="alert" id="formAlert" role="alert" hidden></p>

    <div class="nav">
      <button type="button" class="back" id="backBtn" hidden>Back</button>
      <button type="submit" class="next shine" id="nextBtn">Continue</button>
    </div>
  </form>

  <div class="success" id="successState" hidden tabindex="-1">
    <div class="tick"><svg viewBox="0 0 24 24"><path d="m5 12 5 5L20 7"></path></svg></div>
    <p class="success-title" id="successTitle">You're on the list.</p>
    <p class="success-msg" id="successMsg"></p>
    <div class="community">
      <p>Join the Byllora community on WhatsApp for launch news and early updates.</p>
      <a class="wa-btn" id="waCommunity" href={WHATSAPP_COMMUNITY} target="_blank" rel="noopener noreferrer">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2zm0 18.2a8.2 8.2 0 0 1-4.2-1.1l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.3-.4.3-.4.7-1.4.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.7 11.8 11.8 0 0 0 4.5 4c1.7.7 2.3.8 3.2.6.5-.1 1.5-.6 1.7-1.2.2-.6.2-1.1.2-1.2-.1-.1-.2-.2-.5-.3z"></path></svg>
        Join our WhatsApp community
      </a>
    </div>
  </div>
</div>

<script>
  import { initWaitlistForm } from '../scripts/waitlist-form';
  initWaitlistForm();
</script>
